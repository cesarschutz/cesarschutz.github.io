---
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/jetbrains-mono/index.css";
import "@fontsource/fraunces/latin-500.css";
import "@fontsource/fraunces/latin-600.css";
import "@fontsource/fraunces/latin-700.css";
import "@fontsource/fraunces/latin-500-italic.css";
import "@fontsource/fraunces/latin-700-italic.css";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import SearchDialog from "../components/SearchDialog.astro";
import { ANALYTICS, SITE } from "../config";
import { metaDescription } from "../utils/seo";

interface Props {
  title?: string;
  description?: string;
  /** imagem de compartilhamento (PNG/JPG); padrão: /og/default.png */
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  /** item do menu a destacar (href), quando o caminho não basta (ex.: posts) */
  navActive?: string;
}

const { title, description = SITE.description, image, type = "website", publishedTime, modifiedTime, navActive } =
  Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.homeTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? "/og/default.png", Astro.site).href;
const metaDesc = metaDescription(description) ?? SITE.description;
---

<!doctype html>
<html lang="pt-BR" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f7fb" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title ?? SITE.homeTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />


    <!-- anti-flash: tema salvo > preferência do sistema > escuro -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var saved = localStorage.getItem("cs-theme");
          if (saved === "light" || saved === "dark") root.dataset.theme = saved;
          else root.dataset.theme = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
          var view = localStorage.getItem("cs-post-view");
          if (view === "cards" || view === "list") root.dataset.postView = view;
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
    {
      ANALYTICS.goatcounter && (
        <script
          is:inline
          data-goatcounter={`https://${ANALYTICS.goatcounter}.goatcounter.com/count`}
          async
          src="//gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Nav active={navActive} />
    <main id="conteudo" class="page">
      <slot />
    </main>
    <Footer />
    <SearchDialog />
  </body>
</html>
