---
import { IdToSlug } from "../utils/hash";
import { GetCategoryUrl } from "../utils/content";
import { Icon } from "astro-icon/components";
import PostCardInfoIcon from "./widgets/PostCardInfoIcon.astro";
import { GetCoverURLForUnspecifiedEntry } from "../utils/cover";
import { i18n } from "../locales/translation";
import I18nKeys from "../locales/keys";
import YukinaConfig from "../../yukina.config";
import { formatDate } from "../utils/date";
import { renderInlineMd } from "../utils/inline-md";

export interface Props {
  id: string;
  title: string;
  published: Date;
  category?: string;
  tags?: string[];
  description?: string;
  image?: string;
  readingMetadata: { time: number; wordCount: number };
}

const props = Astro.props;
const entryID = IdToSlug(props.id);
const contentUrl = `/posts/${entryID}`;
const { time } = props.readingMetadata;
---

<div class="mx-3 flex flex-col rounded-3xl bg-[var(--card-color)] lg:mx-0">
  <a
    href={contentUrl}
    class="relative h-[128px] transition-all hover:brightness-75 lg:hidden"
  >
    <img
      class="lozad absolute left-0 top-0 h-full w-full rounded-t-3xl object-cover lg:hidden"
      data-src={props.image ?? GetCoverURLForUnspecifiedEntry(entryID)}
      alt="Capa do post"
    />
    <div class="absolute bottom-2 w-full">
      <div class="mx-2 flex flex-row justify-between">
        <div
          class="flex flex-row items-center space-x-2 rounded-md bg-black/50 px-1.5 py-0.5 text-[var(--primary-color-lighten)] dark:text-[var(--text-color)]"
        >
          <Icon name="cuida:calendar-outline" />
          <span class="select-none">
            {formatDate(props.published, YukinaConfig.locale)}
          </span>
        </div>
        {
          props.category && (
            <div class="flex flex-row items-center space-x-2 rounded-md bg-black/50 px-1.5 py-0.5 text-[var(--primary-color-lighten)] dark:text-[var(--text-color)]">
              <Icon name="dashicons:category" />
              <span class="max-w-44 select-none truncate">
                {props.category}
              </span>
            </div>
          )
        }
      </div>
    </div>
  </a>
  <div class="flex flex-row lg:min-h-[240px]">
    <div
      class="flex min-w-0 flex-1 flex-col gap-y-2 pb-5 pl-5 pr-5 pt-3 lg:gap-y-3 lg:py-6 lg:pr-2"
    >
      <div class="flex w-full flex-row items-start">
        <div
          class="mx-2 mt-[6px] hidden h-6 w-1 rounded-lg bg-[var(--primary-color)] lg:block"
        >
        </div>
        <a href={contentUrl} class="title">
          <span>{props.title}</span>
          <Icon
            name="cuida:caret-right-outline"
            class="mb-1 inline-block align-middle text-[var(--primary-color)]"
          />
        </a>
      </div>
      <div class="ml-2 hidden lg:block">
        <ul class="flex flex-row flex-wrap gap-x-4 gap-y-1.5">
          <li class="data space-x-2">
            <PostCardInfoIcon name="cuida:calendar-outline" />
            <span class="select-none">
              {formatDate(props.published, YukinaConfig.locale)}
            </span>
          </li>
          {
            props.category && (
              <li class="data space-x-1.5">
                <PostCardInfoIcon name="dashicons:category" />
                <a
                  class="select-none whitespace-nowrap rounded-md px-1.5 py-0.5 text-[var(--text-color-lighten)] transition-all hover:bg-[var(--primary-color-lighten)] hover:text-[var(--primary-color)]"
                  href={GetCategoryUrl(props.category)}
                >
                  {props.category}
                </a>
              </li>
            )
          }
        </ul>
      </div>
      {
        props.tags && props.tags.length > 0 && (
          <div class="-mt-1 lg:ml-2">
            <ul class="flex flex-row flex-wrap gap-x-2.5 gap-y-1">
              {props.tags.map((tag) => (
                <li>
                  <a class="tag" href={`/tags/${IdToSlug(tag)}`}>
                    #{tag}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <div class="lg:ml-2">
        <p class="desc" set:html={renderInlineMd(props.description)} />
      </div>
      <div class="mt-auto">
        <div class="select-none lg:ml-2">
          <div class="reading-time">
            <span>
              {time}
              {i18n(I18nKeys.post_card_minutes)}
            </span>
          </div>
        </div>
      </div>
    </div>
    <div class="cover-container">
      <a href={contentUrl} class="cover-wrapper">
        <Icon class="right-icon" name="cuida:caret-right-outline" size={96} />
        <img
          class="lozad absolute inset-0 h-full w-full select-none rounded-r-3xl object-cover dark:brightness-90"
          data-src={props.image ?? GetCoverURLForUnspecifiedEntry(entryID)}
          alt="Capa do post"
        />
      </a>
    </div>
  </div>
</div>
<style>
  .title {
    @apply w-full align-top text-xl font-semibold leading-snug text-[var(--text-color)] lg:text-2xl;
    @apply transition-all hover:text-[var(--primary-color)];
    font-family: var(--primary-font);
  }

  .data {
    font-family: var(--primary-font);
    @apply flex flex-row items-center;
  }

  .data > span {
    @apply inline-block self-center align-middle text-[var(--text-color-lighten)];
    font-family: var(--primary-font);
  }

  .tag {
    @apply select-none text-xs text-[var(--text-color-lighten)] opacity-80 transition-all hover:text-[var(--primary-color)] hover:opacity-100;
    font-family: var(--primary-font);
  }

  .desc {
    @apply text-sm leading-relaxed text-[var(--text-color)];
    font-family: var(--primary-font);
  }

  .desc :global(strong) {
    @apply font-bold;
    color: var(--primary-color);
  }

  .desc :global(code) {
    @apply rounded px-1 text-[0.8rem];
    font-family: var(--code-font);
    color: var(--primary-color);
    background-color: var(--primary-color-transparent);
  }

  .reading-time {
    @apply space-x-3 align-middle text-sm text-[var(--text-color-lighten)];
    font-family: var(--primary-font);
  }

  .cover-container {
    @apply relative ml-2 hidden min-w-[360px] max-w-[360px] select-none self-stretch lg:block;
    clip-path: polygon(0 0%, 100% 0%, 100% 100%, 10% 100%);
  }

  .cover-wrapper {
    @apply block h-full w-full select-none overflow-hidden rounded-r-3xl;
  }

  .cover-wrapper::before {
    @apply absolute left-0 h-full w-0 select-none rounded-r-3xl bg-black opacity-50;
    content: "";
    z-index: 1;
    transition: all 0.3s;
  }

  .cover-wrapper::before:hover {
    @apply h-full w-full select-none;
  }

  .right-icon {
    @apply absolute left-1/2 top-1/2 z-[10] -translate-x-1/2 -translate-y-1/2 text-white;
    clip-path: polygon(0 0, 0 0, 0 100%, 0 100%);
    transition: all 0.3s;
  }

  .cover-wrapper:hover .right-icon {
    clip-path: polygon(0 0, 100% 0%, 100% 100%, 0 100%);
  }
</style>
