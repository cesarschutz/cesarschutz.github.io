---
import Brand from "./Brand.astro";
import Icon from "./Icon.astro";
import { NAV, SITE } from "../config";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <Brand />
      <p>{SITE.headline}</p>
    </div>

    <nav class="footer-links" aria-label="Rodapé">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/series/">Séries</a>
      <a href="/categories/">Categorias</a>
      <a href="/tags/">Tags</a>
    </nav>

    <div class="footer-bottom">
      <span>
        © {year} {SITE.name} · Conteúdo sob{" "}
        <a href={SITE.license.url} target="_blank" rel="noopener noreferrer">{SITE.license.name}</a>
      </span>
      <span class="footer-social">
        <a href="/rss.xml" aria-label="RSS"><Icon name="rss" size={16} /></a>
        <a href={SITE.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <Icon name="github" size={16} />
        </a>
      </span>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: 64px;
    border-top: 1px solid var(--divider);
  }

  .footer-inner {
    max-width: calc(var(--page-max) + 2 * var(--page-gutter));
    margin: 0 auto;
    padding: 36px var(--page-gutter) 28px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px 48px;
  }

  .footer-brand p {
    margin: 12px 0 0;
    max-width: 44ch;
    font-size: var(--fs-body-sm);
    color: var(--text-dim);
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 8px 36px;
    align-content: start;
    font-size: var(--fs-body-sm);
  }

  .footer-links a {
    color: var(--text-soft);
  }

  .footer-links a:hover {
    color: var(--blue);
  }

  .footer-bottom {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 20px;
    border-top: 1px solid var(--divider);
    font-size: var(--fs-meta);
    color: var(--text-dim);
  }

  .footer-bottom a:hover {
    color: var(--blue);
  }

  .footer-social {
    display: flex;
    gap: 14px;
  }

  @media (max-width: 640px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      flex-direction: column-reverse;
      align-items: flex-start;
    }
  }
</style>
