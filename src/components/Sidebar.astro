---
import Icon from "./Icon.astro";
import { getCategories, getSeriesPosts, getTags } from "../utils/posts";
import { SERIES, seriesUrl } from "../data/series";
import { categoryStyle, categoryUrl, tagUrl } from "../utils/taxonomy";

interface Props {
  activeCategory?: string;
  activeTag?: string;
}

const { activeCategory, activeTag } = Astro.props;
const categories = await getCategories();
const tags = (await getTags()).slice(0, 8);
const series = await Promise.all(
  SERIES.map(async (s) => ({ ...s, href: seriesUrl(s), count: (await getSeriesPosts(s.key)).length })),
);
const path = Astro.url.pathname;
---

<aside class="sidebar" aria-label="Navegação do blog">
  <div class="sb-card">
    <section class="sb-section">
      <h2 class="sb-title">Séries</h2>
      <div class="sb-series-list">
        {
          series.map((s) => (
            <a
              class:list={["sb-series", { active: path.startsWith(s.href) }]}
              href={s.href}
              style={`--c:${s.color}`}
            >
              <span class="cat-ico series-ico">
                <Icon name={s.icon} size={18} />
              </span>
              <span class="sb-series-text">
                <strong>{s.name}</strong>
              </span>
              <span class="sb-count">{s.count}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="sb-section">
      <h2 class="sb-title">Categorias</h2>
      <ul class="sb-list">
        {
          categories.map((cat) => {
            const style = categoryStyle(cat.name);
            return (
              <li>
                <a
                  class:list={["sb-item", { active: cat.name === activeCategory }]}
                  href={categoryUrl(cat.name)}
                  aria-current={cat.name === activeCategory ? "page" : undefined}
                >
                  <span class="cat-ico" style={`--c:${style.color}`}>
                    <Icon name={style.icon} size={15} />
                  </span>
                  <span class="sb-item-name">{cat.name}</span>
                  <span class="sb-count">{cat.posts.length}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>

    <section class="sb-section">
      <h2 class="sb-title">Tags</h2>
      <div class="sb-tags">
        {
          tags.map((tag) => (
            <a
              class:list={["sb-tag", { active: tag.name === activeTag }]}
              href={tagUrl(tag.name)}
              aria-current={tag.name === activeTag ? "page" : undefined}
            >
              {tag.name}
            </a>
          ))
        }
      </div>
      <a class="sb-more" href="/tags/">
        Todas as tags <Icon name="arrowRight" size={14} />
      </a>
    </section>

    <a class="sb-rss" href="/rss.xml">
      <Icon name="rss" size={15} /> Assinar via RSS
    </a>
  </div>
</aside>

<style>
  .sidebar {
    position: sticky;
    top: calc(var(--nav-height) + 20px);
    max-height: calc(100svh - var(--nav-height) - 40px);
    overflow-y: auto;
    scrollbar-width: thin;
    border-radius: var(--radius-lg);
  }

  .sb-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--card-bg);
  }

  .sb-section {
    padding: 8px 4px 10px;
  }

  .sb-section + .sb-section {
    border-top: 1px solid var(--divider);
    padding-top: 14px;
  }

  .sb-title {
    margin: 0 8px 8px;
    font-size: var(--fs-eyebrow);
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .sb-series-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .sb-series {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px;
    border-radius: 14px;
    border: 1px solid color-mix(in srgb, var(--c) 26%, var(--border));
    background: color-mix(in srgb, var(--c) 7%, var(--card-bg));
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .sb-series:hover,
  .sb-series.active {
    border-color: color-mix(in srgb, var(--c) 55%, var(--border));
    background: color-mix(in srgb, var(--c) 12%, var(--card-bg));
  }

  .series-ico {
    width: 36px;
    height: 36px;
    border-radius: 10px;
  }

  .sb-series-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }

  .sb-series-text strong {
    font-size: var(--fs-body-sm);
    line-height: 1.3;
    font-weight: 600;
  }

  .sb-series-text span {
    font-size: 12px;
    color: var(--text-dim);
  }

  .sb-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sb-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 8px;
    border-radius: 11px;
    font-size: var(--fs-body);
    color: var(--text);
    transition: background-color 0.15s ease;
  }

  .sb-item:hover,
  .sb-item.active {
    background: var(--card-bg-alt);
  }

  .sb-item.active .sb-item-name {
    font-weight: 600;
  }

  .sb-item-name {
    flex: 1;
    min-width: 0;
  }

  .sb-count {
    min-width: 26px;
    padding: 1px 7px;
    border-radius: 980px;
    font-size: 12px;
    font-weight: 600;
    text-align: center;
    font-variant-numeric: tabular-nums;
    color: var(--text-dim);
    background: var(--card-bg-alt);
  }

  .sb-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0 4px;
  }

  .sb-tag {
    padding: 3px 10px;
    border-radius: 980px;
    border: 1px solid var(--border);
    font-size: var(--fs-meta);
    color: var(--text-soft);
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .sb-tag:hover,
  .sb-tag.active {
    color: var(--blue);
    border-color: color-mix(in srgb, var(--blue) 45%, var(--border));
  }

  .sb-more {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin: 12px 8px 0;
    font-size: var(--fs-meta);
    color: var(--blue);
  }

  .sb-rss {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    border-top: 1px solid var(--divider);
    font-size: var(--fs-meta);
    color: var(--text-dim);
  }

  .sb-rss:hover {
    color: var(--amber);
  }

  @media (max-width: 1023px) {
    .sidebar {
      position: static;
      max-height: none;
      overflow: visible;
    }
    .sb-card {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 0 12px;
    }
    .sb-section + .sb-section {
      border-top: none;
      padding-top: 8px;
    }
    .sb-rss {
      grid-column: 1 / -1;
    }
  }
</style>
