<script>
  import lozad from "lozad";
  import { OverlayScrollbars } from "overlayscrollbars";

  // setup post url
  const setupUrlAnchor = () => {
    const url = window.location.href;
    const urlElement = document.getElementById("post-url") as HTMLAnchorElement;
    if (urlElement) {
      urlElement.href = url;
      urlElement.innerText = url;
    }
  };

  // setup lazy load for images
  const setupLozad = () => {
    const observer = lozad(".lozad", {
      loaded: (el) => {
        el.classList.add("loaded");
      },
    });

    observer.observe();
  };

  // add global scroll bar
  const setupScrollBar = () => {
    OverlayScrollbars(
      { target: document.body, cancel: { nativeScrollbarsOverlaid: true } },
      {
        scrollbars: {
          theme: "scrollbar-base scrollbar-auto py-1",
          autoHide: "move",
        },
      },
    );
    document.body.classList.remove("overflow-y-hidden");

    // add scrollbar for code blocks
    // (Expressive Code e Mermaid têm rolagem própria — não aplicar neles)
    document.querySelectorAll("pre").forEach((ele) => {
      if (ele.closest(".expressive-code") || ele.classList.contains("mermaid"))
        return;
      OverlayScrollbars(ele, {
        scrollbars: {
          theme: "scrollbar-base scrollbar-dark px-2",
          autoHide: "leave",
          autoHideDelay: 500,
          autoHideSuspend: false,
        },
      });
    });
  };

  // lightbox: clicar numa imagem de post abre em tela cheia
  // (fecha no botão ×, clicando fora da imagem ou com Esc)
  const setupLightbox = () => {
    if ((window as any).__lightboxReady) return;
    (window as any).__lightboxReady = true;

    const overlay = document.createElement("div");
    overlay.id = "img-lightbox";
    overlay.innerHTML = `<button class="lb-close" aria-label="Fechar">×</button><img alt="" />`;
    document.body.appendChild(overlay);

    const imgEl = overlay.querySelector("img") as HTMLImageElement;
    const close = () => {
      overlay.classList.remove("open");
    };
    const open = (src: string, alt: string) => {
      imgEl.src = src;
      imgEl.alt = alt;
      overlay.classList.add("open");
    };

    overlay.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).tagName !== "IMG") close();
    });
    overlay.querySelector(".lb-close")!.addEventListener("click", close);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
    document.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (
        t.tagName === "IMG" &&
        t.closest(".article") &&
        !t.closest("#img-lightbox") &&
        !t.closest("a")
      ) {
        const img = t as HTMLImageElement;
        open(img.currentSrc || img.src, img.alt);
      }
    });
  };

  // sumário lateral dos posts: destaca a seção visível durante a rolagem
  const setupToc = () => {
    const previous = (window as any).__tocScrollHandler;
    if (previous) document.removeEventListener("scroll", previous, true);

    const toc = document.querySelector("[data-toc]");
    if (!toc) return;

    const links = new Map<string, HTMLElement>();
    toc.querySelectorAll<HTMLElement>("[data-toc-link]").forEach((el) => {
      links.set(el.dataset.tocLink!, el);
    });
    const headings = [
      ...document.querySelectorAll<HTMLElement>(
        ".article h2[id], .article h3[id]",
      ),
    ].filter((h) => links.has(h.id));
    if (headings.length === 0) return;

    let activeId = "";
    const handler = () => {
      let current = headings[0].id;
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= 120) current = heading.id;
        else break;
      }
      if (current === activeId) return;
      activeId = current;
      links.forEach((el, id) => el.classList.toggle("active", id === current));
    };
    (window as any).__tocScrollHandler = handler;
    document.addEventListener("scroll", handler, true);
    handler();
  };

  // init
  const setup = () => {
    setupUrlAnchor();
    setupLozad();
    setupScrollBar();
    setupLightbox();
    setupToc();
  };

  document.addEventListener("DOMContentLoaded", setup);
  if (window.swup?.hooks) {
    setup();
  } else {
    document.addEventListener("swup:enable", () => {
      window.swup.hooks.on("content:replace", setup);
    });
  }
</script>
