---
/**
 * Repete o título do banner dentro do card de conteúdo: em janelas baixas
 * (ou depois de rolar) o banner some e o leitor perde a referência de onde
 * está. Usado nas listas de arquivo, índices de tags/categorias e /exercicios.
 */
export interface Props {
  title: string;
  subTitle?: string;
}
const { title, subTitle } = Astro.props;
---

<div class="page-header">
  {subTitle && <p class="page-eyebrow">{subTitle}</p>}
  <h2 class="page-title">{title}</h2>
</div>

<style>
  .page-header {
    @apply mb-6 border-b pb-4;
    border-color: var(--primary-color-transparent);
  }

  .page-eyebrow {
    @apply text-xs font-bold uppercase;
    letter-spacing: 0.25em;
    color: var(--primary-color);
  }

  .page-title {
    @apply mt-1 text-2xl font-bold lg:text-3xl;
    color: var(--text-color);
    font-family: var(--title-font);
  }
</style>
