---
import { TILES } from "../data/tiles";

interface Props {
  /** quantidade simultânea de tiles */
  count?: number;
  /** duração base de uma subida, em segundos */
  baseDur?: number;
  class?: string;
}

const { count = 16, baseDur = 16, class: className } = Astro.props;
---

<!--
  Tiles subindo em "lanes" (colunas) — porte do falling-tiles do DEV NOTE.
  Contido no elemento pai (position: relative), pausa fora da tela e
  respeita prefers-reduced-motion.
-->
<div
  class:list={["tiles-stage", className]}
  data-tiles
  data-count={count}
  data-base-dur={baseDur}
  data-subjects={JSON.stringify(TILES)}
  aria-hidden="true"
>
</div>

<script>
  import type { Tile } from "../data/tiles";

  const shuffle = <T,>(arr: T[]) => {
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  };
  const clamp = (v: number, min: number, max: number) => Math.max(min, Math.min(max, v));

  function sizeFor(tile: Tile, stageW: number) {
    const small = stageW < 420;
    if (tile.kind === "topic") return small ? 34 : 40;
    return small ? 38 : 46;
  }

  function init(stage: HTMLElement) {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const subjects = shuffle(JSON.parse(stage.dataset.subjects ?? "[]") as Tile[]);
    const baseDur = Number(stage.dataset.baseDur ?? 16);
    let stageW = stage.clientWidth;
    const stageH = () => Math.max(stage.clientHeight, 120);
    stage.style.setProperty("--stage-h", `${stageH()}px`);

    const LANE = 72;
    let numLanes = Math.max(3, Math.floor(stageW / LANE));
    const count = Math.min(Number(stage.dataset.count ?? 16), subjects.length, numLanes * 3);
    const laneDur = Array.from({ length: 12 }, () => baseDur * (0.85 + Math.random() * 0.3));

    const place = (tile: HTMLElement, lane: number, phase: number) => {
      const size = Number(tile.dataset.size);
      const laneW = stageW / numLanes;
      const jitter = (Math.random() * 2 - 1) * Math.max(0, laneW / 2 - size / 2 - 6);
      const x = clamp((lane + 0.5) * laneW + jitter, size / 2 + 14, stageW - size / 2 - 14);
      const dur = laneDur[lane % laneDur.length];
      tile.dataset.lane = String(lane);
      tile.style.setProperty("--x", `${(x - size / 2).toFixed(1)}px`);
      tile.style.setProperty("--dur", `${dur.toFixed(2)}s`);
      tile.style.setProperty("--delay", `${(-phase * dur).toFixed(2)}s`);
      tile.style.animationName = "none";
      void tile.offsetWidth;
      tile.style.removeProperty("animation-name");
    };

    const laneOrder = shuffle([...Array(numLanes).keys()]);
    for (let i = 0; i < count; i++) {
      const s = subjects[i % subjects.length];
      const size = sizeFor(s, stageW);
      const tile = document.createElement("div");
      tile.className = `tile is-${s.kind}${s.invertOnLight ? " invert-light" : ""}`;
      tile.dataset.size = String(size);
      const wobble = 2.5 + Math.random() * 2;
      tile.style.cssText = `--size:${size}px;--c:${s.color};--wobble-dur:${wobble.toFixed(2)}s;--wobble-delay:${(-Math.random() * wobble).toFixed(2)}s`;

      const inner = document.createElement("div");
      inner.className = "tile-inner";
      if (s.kind === "topic" && s.svg) {
        inner.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${s.svg}</svg>`;
      } else if (s.src) {
        const img = document.createElement("img");
        img.src = s.src;
        img.alt = "";
        img.loading = "lazy";
        img.decoding = "async";
        img.addEventListener("error", () => tile.remove());
        inner.appendChild(img);
      }
      const label = document.createElement("span");
      label.className = "tile-label";
      label.textContent = s.name;
      tile.append(inner, label);

      const phase = (i / count + (Math.random() * 2 - 1) * 0.03 + 1) % 1;
      place(tile, laneOrder[i % numLanes], phase);
      // no fim de cada subida, reposiciona na mesma lane
      tile.addEventListener("animationend", (e) => {
        if ((e as AnimationEvent).animationName === "tile-rise") place(tile, Number(tile.dataset.lane), 0);
      });
      stage.appendChild(tile);
    }

    const reshuffle = () => {
      const order = shuffle([...Array(numLanes).keys()]);
      const tiles = [...stage.querySelectorAll<HTMLElement>(".tile")];
      tiles.forEach((t, i) => place(t, order[i % numLanes], (i / tiles.length + Math.random() * 0.03) % 1));
    };

    // brilho passando em tiles aleatórios
    let shineTimer: number | undefined;
    const startShine = () => {
      stopShine();
      shineTimer = window.setInterval(() => {
        const tiles = shuffle([...stage.querySelectorAll<HTMLElement>(".tile")]).slice(0, 3);
        tiles.forEach((t) => {
          t.classList.remove("is-shining");
          void t.offsetWidth;
          t.classList.add("is-shining");
        });
      }, 3000);
    };
    const stopShine = () => shineTimer !== undefined && clearInterval(shineTimer);

    // pausa quando o card sai da tela
    new IntersectionObserver(([entry]) => {
      stage.classList.toggle("is-paused", !entry.isIntersecting);
      entry.isIntersecting ? startShine() : stopShine();
    }).observe(stage);

    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") requestAnimationFrame(reshuffle);
    });

    let resizeTimer: number | undefined;
    new ResizeObserver(() => {
      stage.style.setProperty("--stage-h", `${stageH()}px`);
      if (Math.abs(stage.clientWidth - stageW) < 30) return;
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        stageW = stage.clientWidth;
        numLanes = Math.max(3, Math.floor(stageW / LANE));
        stage.querySelectorAll<HTMLElement>(".tile").forEach((t) => {
          const size = sizeFor({ kind: t.classList.contains("is-topic") ? "topic" : "logo" } as Tile, stageW);
          t.dataset.size = String(size);
          t.style.setProperty("--size", `${size}px`);
        });
        reshuffle();
      }, 150);
    }).observe(stage);
  }

  document.querySelectorAll<HTMLElement>("[data-tiles]").forEach(init);
</script>

<style>
  .tiles-stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    mask-image: linear-gradient(to bottom, transparent 0%, #000 18%, #000 82%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 18%, #000 82%, transparent 100%);
  }

  .tiles-stage.is-paused :global(.tile),
  .tiles-stage.is-paused :global(.tile-inner) {
    animation-play-state: paused;
  }

  .tiles-stage :global(.tile) {
    position: absolute;
    left: 0;
    bottom: 0;
    width: var(--size);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    pointer-events: auto;
    animation: tile-rise var(--dur, 16s) var(--delay, 0s) linear infinite;
    will-change: transform;
  }

  .tiles-stage :global(.tile-inner) {
    position: relative;
    width: var(--size);
    height: var(--size);
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--c) 35%, var(--border));
    background: var(--card-bg-alt);
    opacity: 0.9;
    box-shadow:
      var(--shadow-card),
      0 0 14px 3px color-mix(in srgb, var(--c) 30%, transparent);
    animation: tile-wobble var(--wobble-dur, 4s) var(--wobble-delay, 0s) ease-in-out infinite alternate both;
    transition:
      scale 0.35s var(--ease-spring),
      box-shadow 0.3s ease,
      opacity 0.25s ease;
  }

  .tiles-stage :global(.tile-inner img) {
    width: 70%;
    height: 70%;
    object-fit: contain;
  }

  .tiles-stage :global(.is-topic .tile-inner) {
    color: var(--c);
    background: color-mix(in srgb, var(--c) 15%, var(--card-bg));
  }

  .tiles-stage :global(.is-topic .tile-inner svg) {
    width: 62%;
    height: 62%;
  }

  :global([data-theme="light"]) .tiles-stage :global(.invert-light img) {
    filter: invert(1);
  }

  .tiles-stage :global(.tile-label) {
    font-size: 10px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    color: var(--c);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .tiles-stage :global(.tile:hover .tile-inner) {
    scale: 1.15;
    opacity: 1;
    box-shadow:
      var(--shadow-card),
      0 0 24px 7px color-mix(in srgb, var(--c) 45%, transparent);
  }

  .tiles-stage :global(.tile:hover .tile-label) {
    opacity: 1;
  }

  .tiles-stage :global(.tile-inner::after) {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 35%, rgb(255 255 255 / 0.5) 50%, transparent 65%) no-repeat;
    background-size: 250% 100%;
    background-position: 150% 0;
    pointer-events: none;
  }

  .tiles-stage :global(.tile.is-shining .tile-inner::after) {
    animation: tile-shine 0.9s linear forwards;
  }

  @keyframes tile-rise {
    from {
      transform: translate3d(var(--x, 0), 100%, 0);
    }
    to {
      transform: translate3d(var(--x, 0), calc(-1 * var(--stage-h, 300px) - 100%), 0);
    }
  }

  @keyframes tile-wobble {
    from {
      transform: rotate(-6deg);
    }
    to {
      transform: rotate(6deg);
    }
  }

  @keyframes tile-shine {
    from {
      background-position: 150% 0;
    }
    to {
      background-position: -150% 0;
    }
  }
</style>
