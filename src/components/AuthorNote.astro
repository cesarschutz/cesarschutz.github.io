---
import Icon from "./Icon.astro";
import { SITE } from "../config";

/** Bloco curto de assinatura no fim da home: quem escreve e para onde ir depois. */
---

<section class="author card rise" style="--i:4" aria-labelledby="author-note-title">
  <img
    class="an-photo"
    src={SITE.avatar}
    alt=""
    width="88"
    height="88"
    loading="lazy"
    decoding="async"
  />

  <div class="an-text">
    <p class="eyebrow" id="author-note-title">Sobre o autor</p>
    <p class="an-body">
      Sou <strong>{SITE.name}</strong>, {SITE.role.toLowerCase()}. {SITE.authorNote}
    </p>
    <div class="an-actions">
      <a class="an-link" href="/about/">
        Conheça o autor <Icon name="arrowRight" size={15} />
      </a>
      <a class="an-icon" href={SITE.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub de Cesar Schutz">
        <Icon name="github" size={17} />
      </a>
      {
        SITE.linkedin && (
          <a
            class="an-icon"
            href={SITE.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn de Cesar Schutz"
          >
            <Icon name="linkedin" size={17} />
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .author {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 18px;
    align-items: center;
    margin-top: var(--col-gap);
    padding: clamp(18px, 2.2vw, 26px);
    border-radius: var(--radius-lg);
  }

  .an-photo {
    width: 88px;
    aspect-ratio: 1;
    height: auto;
    object-fit: cover;
    border-radius: 16px;
    border: 1px solid var(--border);
  }

  .an-body {
    margin: 6px 0 0;
    max-width: 62ch;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--text-soft);
  }

  .an-body strong {
    color: var(--text);
    font-weight: 600;
  }

  .an-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 14px;
    margin-top: 12px;
  }

  .an-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-body-sm);
    font-weight: 600;
    color: var(--blue);
  }

  .an-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .an-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    color: var(--text-dim);
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }

  .an-icon:hover {
    color: var(--text);
    background: var(--card-bg-alt);
  }

  @media (max-width: 560px) {
    .author {
      grid-template-columns: 56px minmax(0, 1fr);
      gap: 14px;
      align-items: start;
    }
    .an-photo {
      width: 56px;
      border-radius: 12px;
    }
  }
</style>
