---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
// cada h3 pertence ao h2 anterior; sumários longos mostram só os subtópicos da seção atual
let group = 0;
const grouped = items.map((h) => ({ ...h, group: h.depth === 2 ? ++group : group }));
const collapsible = items.length > 14;
---

{
  items.length >= 3 && (
    <nav class="toc" aria-label="Neste artigo" data-toc data-collapsible={collapsible ? "" : undefined}>
      <p class="toc-title">Neste artigo</p>
      <ol>
        {grouped.map((h) => (
          <li class={`d${h.depth}`} data-group={h.group}>
            <a href={`#${h.slug}`} data-toc-link={h.slug}>
              {h.text.replace(/#$/, "")}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<script>
  // há dois sumários na página (lateral e o recolhível do celular): atualiza os dois
  const tocs = [...document.querySelectorAll<HTMLElement>("[data-toc]")];
  const headings = [...document.querySelectorAll<HTMLElement>(".prose h2[id], .prose h3[id], [data-toc-heading][id]")];

  if (tocs.length && headings.length) {
    let active = "";
    const update = () => {
      let current = headings[0].id;
      for (const h of headings) {
        if (h.getBoundingClientRect().top <= 140) current = h.id;
        else break;
      }
      if (current === active) return;
      active = current;
      for (const toc of tocs) {
        let activeLink: HTMLElement | null = null;
        toc.querySelectorAll<HTMLElement>("[data-toc-link]").forEach((a) => {
          const on = a.dataset.tocLink === current;
          a.classList.toggle("active", on);
          if (on) activeLink = a;
        });
        // sumário longo no card lateral: recolhe subtópicos das outras seções
        if (toc.hasAttribute("data-collapsible") && toc.closest(".toc-card")) {
          const group = (activeLink as HTMLElement | null)?.closest("li")?.dataset.group;
          toc.querySelectorAll<HTMLElement>("li.d3").forEach((li) => {
            li.classList.toggle("is-collapsed", li.dataset.group !== group);
          });
        }
        // mantém o item ativo visível dentro do card, sem rolar a página
        const box = toc.closest<HTMLElement>(".toc-card");
        if (box && activeLink) {
          const link = activeLink as HTMLElement;
          const top = link.offsetTop;
          if (top < box.scrollTop + 40 || top > box.scrollTop + box.clientHeight - 40) {
            box.scrollTo({ top: top - box.clientHeight / 2 });
          }
        }
      }
    };
    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      },
      { passive: true },
    );
    update();
  }
</script>

<style>
  .toc {
    font-size: var(--fs-meta);
  }

  .toc-title {
    margin: 0 0 10px;
    font-size: var(--fs-eyebrow);
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--divider);
  }

  .toc a {
    display: block;
    margin-left: -1px;
    padding: 5px 0 5px 14px;
    border-left: 2px solid transparent;
    line-height: 1.4;
    color: var(--text-dim);
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .toc .d3 a {
    padding-left: 26px;
    font-size: 12.5px;
  }

  .toc a:hover {
    color: var(--text);
  }

  .toc li.is-collapsed {
    display: none;
  }

  .toc a.active {
    color: var(--blue);
    border-left-color: var(--blue);
    font-weight: 600;
  }
</style>
