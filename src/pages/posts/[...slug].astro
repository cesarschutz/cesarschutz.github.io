---
import { IdToSlug } from "../../utils/hash";
import PostLayout from "../../layouts/PostLayout.astro";
import { render } from "astro:content";
import { GetSortedPosts } from "../../utils/content";

export async function getStaticPaths() {
  const sorted = await GetSortedPosts();
  return sorted.map((entry, index) => ({
    params: { slug: IdToSlug(entry.id) },
    props: {
      entry,
      // ordenação decrescente por data: [index+1] é o post mais antigo (anterior),
      // [index-1] é o mais novo (próximo)
      prev: sorted[index + 1]
        ? {
            title: sorted[index + 1].data.title,
            url: `/posts/${IdToSlug(sorted[index + 1].id)}/`,
          }
        : undefined,
      next: sorted[index - 1]
        ? {
            title: sorted[index - 1].data.title,
            url: `/posts/${IdToSlug(sorted[index - 1].id)}/`,
          }
        : undefined,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
---

<PostLayout
  title={entry.data.title}
  subTitle={entry.data.description}
  bannerImage={entry.data.cover}
  published={entry.data.published}
  category={entry.data.category}
  tags={entry.data.tags}
  readingMetadata={(remarkPluginFrontmatter as any).readingMetadata}
  headings={headings}
  license={
    entry.data.licenseName
      ? { name: entry.data.licenseName, url: entry.data.licenseUrl }
      : undefined
  }
  author={entry.data.author}
  sourceLink={entry.data.sourceLink}
  prevPost={prev}
  nextPost={next}
>
  <Content />
</PostLayout>
