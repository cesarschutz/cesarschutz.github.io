---
import { render } from "astro:content";
import "../../styles/prose.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import Cover from "../../components/Cover.astro";
import Toc from "../../components/Toc.astro";
import Comments from "../../components/Comments.astro";
import { SITE } from "../../config";
import { getPosts, getSummaries, readingMinutes, summarize, type Post } from "../../utils/posts";
import { rawCover } from "../../utils/covers";
import { relatedPosts } from "../../utils/related";
import { getSeries, seriesUrl } from "../../data/series";
import { JAVA_LTS } from "../../data/java";
import { postLabel, tagUrl } from "../../utils/taxonomy";
import { formatDate, isoDate, renderInlineMd, stripInlineMd } from "../../utils/format";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const { title, description, published, updated, tags } = post.data;
const label = postLabel(post.data);
const minutes = readingMinutes(post);
const hasToc = headings.filter((h) => h.depth === 2 || h.depth === 3).length >= 3;
const hasMath = Boolean(remarkPluginFrontmatter?.hasMath);
const wasUpdated = updated && isoDate(updated) !== isoDate(published);

// navegação: dentro da série (ordem própria) e posts relacionados
const all = await getSummaries();
const current = summarize(post);
const series = getSeries(post.data.series);
let seriesPrev: { title: string; url: string } | undefined;
let seriesNext: { title: string; url: string } | undefined;
if (series?.key === "java") {
  // LTS em ordem cronológica (JAVA_LTS vem da mais nova para a mais antiga)
  const order = [...JAVA_LTS].reverse().map((v) => all.find((p) => p.slug === `java-${v.version}`)).filter(Boolean);
  const i = order.findIndex((p) => p!.slug === post.id);
  if (i >= 0) {
    const prev = order[i - 1];
    const next = order[i + 1];
    if (prev) seriesPrev = { title: prev.title, url: prev.url };
    if (next) seriesNext = { title: next.title, url: next.url };
  }
}
// na série, a navegação acima já liga as outras partes: relacionados vêm de fora dela
const related = relatedPosts(current, series ? all.filter((p) => p.series !== series.key) : all);

const postUrl = new URL(`/posts/${post.id}/`, Astro.site).href;
// o PNG de compartilhamento só existe se o post tiver a capa card
const ogImage = rawCover(post.id, "card") ? `/og/${post.id}.png` : undefined;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: stripInlineMd(description),
  datePublished: published.toISOString(),
  dateModified: (updated ?? published).toISOString(),
  inLanguage: "pt-BR",
  url: postUrl,
  mainEntityOfPage: postUrl,
  image: ogImage ? new URL(ogImage, Astro.site).href : undefined,
  keywords: tags.join(", "),
  author: { "@type": "Person", name: SITE.name, url: new URL("/about/", Astro.site).href },
  publisher: { "@type": "Person", name: SITE.name },
};
---

<BaseLayout
  title={title}
  description={stripInlineMd(description) || SITE.description}
  image={ogImage}
  type="article"
  publishedTime={published}
  modifiedTime={updated}
  navActive={series ? "/series/" : "/archive/"}
>
  {hasMath && <link slot="head" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css" />}
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <div class="read-progress" data-read-progress aria-hidden="true"></div>

  <article class:list={["post", { "has-toc": hasToc }]}>
    <header class="post-header card rise">
      <div class="post-cover">
        <Cover post={current} format="wide" class="post-cover-wide" />
        <Cover post={current} format="card" class="post-cover-card" />
      </div>
      <div class="post-head-body">
        <nav class="post-crumbs" aria-label="Trilha">
          {label?.kind === "series" ? <a href="/series/">Séries</a> : <a href="/archive/">Artigos</a>}
          {
            label && (
              <>
                <Icon name="chevRight" size={13} />
                <a class="post-cat" href={label.url} style={`--c:${label.color}`}>
                  <span class="cat-dot" />
                  {label.name}
                </a>
              </>
            )
          }
        </nav>

        <h1 class="post-title">{title}</h1>
        {description && <p class="post-desc" set:html={renderInlineMd(description)} />}

        <div class="post-meta">
          <span class="post-author">
            <img src={SITE.avatar} alt="" width="28" height="28" loading="lazy" />
            {SITE.name}
          </span>
          <span class="post-meta-item">
            <Icon name="calendar" size={14} />
            <time datetime={isoDate(published)}>{formatDate(published)}</time>
          </span>
          {
            wasUpdated && (
              <span class="post-meta-item post-updated">
                <Icon name="refresh" size={14} />
                Atualizado em{" "}
                <time datetime={isoDate(updated!)}>{formatDate(updated!)}</time>
              </span>
            )
          }
          <span class="post-meta-item">
            <Icon name="clock" size={14} />
            {minutes} min de leitura
          </span>
        </div>
      </div>
    </header>

    <div class="post-grid">
      <div class="post-main">
        {
          hasToc && (
            <details class="toc-mobile card">
              <summary>Neste artigo</summary>
              <Toc headings={headings} />
            </details>
          )
        }

        <div class="post-body card rise" style="--i:1">
          <div class="prose">
            <Content />
          </div>

          <footer class="post-foot">
            {
              tags.length > 0 && (
                <div class="post-tags">
                  <Icon name="hash" size={15} />
                  {tags.map((tag) => (
                    <a class="pill" href={tagUrl(tag)}>
                      {tag}
                    </a>
                  ))}
                </div>
              )
            }
            <div class="post-share" data-share>
              <span class="post-share-label">Compartilhar</span>
              <button type="button" class="pill share-btn" data-copy-link={postUrl}>
                <Icon name="link" size={14} /> <span data-copy-label>Copiar link</span>
              </button>
              <a
                class="pill share-btn"
                href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name="linkedin" size={14} /> LinkedIn
              </a>
              <a
                class="pill share-btn"
                href={`https://wa.me/?text=${encodeURIComponent(`${title} ${postUrl}`)}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name="message" size={14} /> WhatsApp
              </a>
              <button type="button" class="pill share-btn share-native" data-native-share hidden>
                <Icon name="share" size={14} /> Mais opções
              </button>
            </div>
            <p class="post-ai">
              Artigo escrito com apoio de IA, revisado pelo autor, com o código testado. Ainda assim pode conter
              imprecisões: confirme nas fontes citadas e na documentação oficial antes de aplicar.
              <a href="/about/#site">Saiba mais</a>.
            </p>
          </footer>
        </div>

        {
          (seriesPrev || seriesNext) && series && (
            <nav class="post-nav" aria-label={`Navegação na série ${series.name}`}>
              <p class="post-nav-heading">
                Na série <a href={seriesUrl(series)}>{series.name}</a>
              </p>
              {seriesPrev ? (
                <a class="post-nav-card" href={seriesPrev.url} rel="prev">
                  <span class="post-nav-dir">
                    <Icon name="arrowLeft" size={14} /> LTS anterior
                  </span>
                  <span class="post-nav-title">{seriesPrev.title}</span>
                </a>
              ) : (
                <span />
              )}
              {seriesNext ? (
                <a class="post-nav-card next" href={seriesNext.url} rel="next">
                  <span class="post-nav-dir">
                    Próxima LTS <Icon name="arrowRight" size={14} />
                  </span>
                  <span class="post-nav-title">{seriesNext.title}</span>
                </a>
              ) : (
                <span />
              )}
            </nav>
          )
        }

        {
          related.length > 0 && (
            <section class="related" aria-labelledby="related-title">
              <h2 class="related-title" id="related-title">
                Artigos relacionados
              </h2>
              <div class="related-grid">
                {related.map((p) => {
                  const l = postLabel(p);
                  return (
                    <a class="related-card" href={p.url}>
                      <span class="related-cover">
                        <Cover post={p} format="card" />
                      </span>
                      <span class="related-body">
                        {l && (
                          <span class="related-cat ink" style={`--c:${l.color}`}>
                            {l.name}
                          </span>
                        )}
                        <span class="related-name">{p.title}</span>
                        <span class="related-min">{p.minutes} min de leitura</span>
                      </span>
                    </a>
                  );
                })}
              </div>
            </section>
          )
        }

        <Comments />
      </div>

      {
        hasToc && (
          <aside class="post-aside">
            <div class="toc-card card">
              <Toc headings={headings} />
            </div>
          </aside>
        )
      }
    </div>
  </article>

  <button type="button" class="to-top" data-to-top aria-label="Voltar ao topo" hidden>
    <Icon name="arrowUp" size={18} />
  </button>

  <div class="lightbox" data-lightbox role="dialog" aria-modal="true" aria-label="Imagem ampliada">
    <button type="button" class="lightbox-close" data-lightbox-close aria-label="Fechar">
      <Icon name="close" size={22} />
    </button>
    <img alt="" />
  </div>
</BaseLayout>

<script>
  // barra de progresso de leitura e botão "voltar ao topo"
  const bar = document.querySelector<HTMLElement>("[data-read-progress]");
  const toTop = document.querySelector<HTMLButtonElement>("[data-to-top]");
  const body = document.querySelector<HTMLElement>(".post-body");
  const onScroll = () => {
    if (body && bar) {
      const rect = body.getBoundingClientRect();
      const total = rect.height - window.innerHeight * 0.6;
      const progress = Math.min(1, Math.max(0, -rect.top / Math.max(total, 1)));
      bar.style.transform = `scaleX(${progress})`;
    }
    if (toTop) toTop.hidden = window.scrollY < window.innerHeight * 1.5;
  };
  let ticking = false;
  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        onScroll();
        ticking = false;
      });
    },
    { passive: true },
  );
  onScroll();
  toTop?.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));

  // compartilhar
  document.querySelector<HTMLButtonElement>("[data-copy-link]")?.addEventListener("click", async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const label = btn.querySelector("[data-copy-label]")!;
    try {
      await navigator.clipboard.writeText(btn.dataset.copyLink!);
      label.textContent = "Link copiado";
    } catch {
      label.textContent = "Não foi possível copiar";
    }
    setTimeout(() => (label.textContent = "Copiar link"), 2000);
  });
  const nativeShare = document.querySelector<HTMLButtonElement>("[data-native-share]");
  if (nativeShare && "share" in navigator) {
    nativeShare.hidden = false;
    nativeShare.addEventListener("click", () => {
      navigator.share({ title: document.title, url: location.href.split("#")[0] }).catch(() => {});
    });
  }

  // lightbox: imagens do corpo do post abrem em tela cheia
  const box = document.querySelector<HTMLElement>("[data-lightbox]")!;
  const img = box.querySelector("img")!;
  const close = () => box.classList.remove("open");
  const open = (src: string, alt: string) => {
    img.src = src;
    img.alt = alt;
    box.classList.add("open");
  };
  box.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).tagName !== "IMG") close();
  });
  document.addEventListener("keydown", (e) => e.key === "Escape" && close());
  document.querySelectorAll<HTMLImageElement>(".prose img").forEach((el) => {
    if (el.closest("a")) return;
    el.addEventListener("click", () => open(el.currentSrc || el.src, el.alt));
  });
</script>

<style>
  .post {
    --post-max: 1180px;
    max-width: var(--post-max);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--col-gap);
  }

  .post-header {
    overflow: hidden;
    border-radius: 22px;
  }

  .post-cover {
    display: block;
    aspect-ratio: 4 / 1;
    border-bottom: 1px solid var(--border);
  }

  .post-cover :global(.post-cover-card) {
    display: none;
  }

  .post-head-body {
    padding: clamp(22px, 3vw, 40px) clamp(20px, 3.4vw, 48px) clamp(24px, 3vw, 36px);
  }

  .post-crumbs {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-meta);
    color: var(--text-dim);
  }

  .post-crumbs a:hover {
    color: var(--blue);
  }

  .post-cat {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    color: color-mix(in srgb, var(--c, var(--blue)) var(--ink-mix), #000) !important;
  }

  .post-title {
    margin-top: 12px;
    text-wrap: pretty;
    font-family: var(--font-serif);
    font-size: clamp(32px, 4.4vw, 54px);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.028em;
  }

  .post-desc {
    margin: 16px 0 0;
    font-size: clamp(17px, 1.5vw, 19px);
    line-height: 1.6;
    color: var(--text-soft);
  }

  .post-desc :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 1px 5px;
    border-radius: 5px;
    background: var(--card-bg-alt);
    color: var(--text);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 20px;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--divider);
    font-size: var(--fs-body-sm);
    color: var(--text-dim);
  }

  .post-author {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--text);
  }

  .post-author img {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
  }

  .post-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--col-gap);
    align-items: start;
  }

  .post.has-toc .post-grid {
    grid-template-columns: minmax(0, 1fr) 250px;
  }

  .post-main {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--col-gap);
  }

  .post-body {
    padding: clamp(22px, 4vw, 56px) clamp(18px, 4.4vw, 64px);
  }

  .post-body .prose {
    max-width: 760px;
    margin: 0 auto;
  }

  .post-foot {
    max-width: 760px;
    margin: 40px auto 0;
    padding-top: 22px;
    border-top: 1px solid var(--divider);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    color: var(--text-dim);
  }

  .post-ai {
    margin: 14px 0 0;
    padding: 10px 14px;
    border-radius: 10px;
    border: 1px solid color-mix(in srgb, var(--amber) 30%, var(--border));
    background: color-mix(in srgb, var(--amber) 6%, transparent);
    font-size: var(--fs-meta);
    line-height: 1.5;
    color: var(--text-soft);
  }

  .post-ai a {
    color: var(--link);
  }


  /* barra de progresso de leitura (logo abaixo da navegação) */
  .read-progress {
    position: fixed;
    top: var(--nav-height);
    left: 0;
    right: 0;
    z-index: 8999;
    height: 3px;
    background: var(--blue);
    transform: scaleX(0);
    transform-origin: 0 50%;
    pointer-events: none;
  }

  .post-updated {
    color: var(--text-soft);
  }

  .post-share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
  }

  .post-share-label {
    margin-right: 4px;
    font-size: var(--fs-meta);
    color: var(--text-dim);
  }

  .share-btn {
    cursor: pointer;
  }

  button.share-btn:hover {
    color: var(--blue);
    border-color: color-mix(in srgb, var(--blue) 45%, var(--border));
  }

  .post-nav-heading {
    grid-column: 1 / -1;
    margin: 0 0 -6px 4px;
    font-size: var(--fs-meta);
    color: var(--text-dim);
  }

  .post-nav-heading a {
    color: var(--link);
  }

  .related-title {
    margin: 8px 4px 14px;
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 12px;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--card-bg);
    transition:
      transform 0.2s var(--ease-out),
      border-color 0.2s ease;
  }

  .related-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
  }

  .related-cover {
    display: block;
    aspect-ratio: 2 / 1;
    border-bottom: 1px solid var(--border);
  }

  .related-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px 16px;
  }

  .related-cat {
    font-size: var(--fs-eyebrow);
    font-weight: 600;
  }

  .related-name {
    font-family: var(--font-serif);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.25;
  }

  .related-card:hover .related-name {
    color: var(--blue);
  }

  .related-min {
    margin-top: auto;
    font-size: var(--fs-meta);
    color: var(--text-dim);
  }

  .to-top {
    position: fixed;
    right: clamp(14px, 2.4vw, 28px);
    bottom: clamp(14px, 2.4vw, 28px);
    z-index: 9000;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: color-mix(in srgb, var(--card-bg) 88%, transparent);
    color: var(--text-soft);
    box-shadow: var(--shadow-card);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    cursor: pointer;
    transition:
      color 0.15s ease,
      scale 0.15s ease;
  }

  .to-top[hidden] {
    display: none;
  }

  .to-top:hover {
    color: var(--blue);
  }

  .to-top:active {
    scale: 0.96;
  }

  .post-aside {
    position: sticky;
    top: calc(var(--nav-height) + 20px);
  }

  .toc-card {
    position: relative;
    max-height: calc(100svh - var(--nav-height) - 40px);
    overflow-y: auto;
    padding: 18px 16px 18px 18px;
    border-radius: var(--radius-md);
    scrollbar-width: thin;
  }

  .toc-mobile {
    display: none;
    border-radius: var(--radius-md);
  }

  .toc-mobile summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
    padding: 14px 18px;
    font-size: var(--fs-body);
    font-weight: 600;
    cursor: pointer;
  }

  .toc-mobile summary::-webkit-details-marker {
    display: none;
  }

  .toc-mobile summary::after {
    content: "";
    width: 7px;
    height: 7px;
    margin-right: 4px;
    border-right: 2px solid var(--text-dim);
    border-bottom: 2px solid var(--text-dim);
    transform: rotate(45deg);
    transition: transform 0.2s ease;
  }

  .toc-mobile[open] summary::after {
    transform: rotate(-135deg);
  }

  .toc-mobile[open] summary {
    border-bottom: 1px solid var(--divider);
  }

  .toc-mobile :global(.toc) {
    padding: 14px 18px 18px;
  }

  .toc-mobile :global(.toc-title) {
    display: none;
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--col-gap);
  }

  .post-nav-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 20px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--card-bg);
    transition:
      border-color 0.2s ease,
      transform 0.2s var(--ease-out);
  }

  .post-nav-card:hover {
    border-color: color-mix(in srgb, var(--blue) 40%, var(--border));
    transform: translateY(-2px);
  }

  .post-nav-card.next {
    text-align: right;
    align-items: flex-end;
  }

  .post-nav-dir {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-meta);
    color: var(--text-dim);
  }

  .post-nav-title {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.25;
  }

  .post-nav-card:hover .post-nav-title {
    color: var(--blue);
  }

  @media (max-width: 1100px) {
    .post.has-toc .post-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .post-aside {
      display: none;
    }
    .toc-mobile {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .post-cover {
      aspect-ratio: 2 / 1;
    }
    .post-cover :global(.post-cover-wide) {
      display: none;
    }
    .post-cover :global(.post-cover-card) {
      display: block;
    }
    .post-nav {
      grid-template-columns: 1fr;
    }
    .post-nav-card.next {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>
