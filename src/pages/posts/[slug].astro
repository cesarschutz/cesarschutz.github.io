---
import { render } from "astro:content";
import "../../styles/prose.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import Toc from "../../components/Toc.astro";
import { SITE } from "../../config";
import { getPosts, readingMinutes, type Post } from "../../utils/posts";
import { postLabel, tagUrl } from "../../utils/taxonomy";
import { formatDate, isoDate, renderInlineMd, stripInlineMd } from "../../utils/format";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // lista em ordem decrescente: o "próximo" (mais novo) fica antes
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, published, tags, cover } = post.data;
const label = postLabel(post.data);
const minutes = readingMinutes(post);
const hasToc = headings.filter((h) => h.depth === 2 || h.depth === 3).length >= 3;
---

<BaseLayout
  title={title}
  description={stripInlineMd(description) || SITE.description}
  image={cover}
  type="article"
  publishedTime={published}
>
  <link slot="head" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css" />

  <article class:list={["post", { "has-toc": hasToc }]}>
    <header class="post-header card rise">
      {
        cover && (
          <button type="button" class="post-cover" data-lightbox-cover aria-label="Ampliar capa">
            <img src={cover} alt="" width="1600" height="800" decoding="async" fetchpriority="high" />
          </button>
        )
      }
      <div class="post-head-body">
        <nav class="post-crumbs" aria-label="Trilha">
          {label?.kind === "series" ? <a href="/series/">Séries</a> : <a href="/archive/">Artigos</a>}
          {
            label && (
              <>
                <Icon name="chevRight" size={13} />
                <a class="post-cat" href={label.url} style={`--c:${label.color}`}>
                  <span class="cat-dot" />
                  {label.name}
                </a>
              </>
            )
          }
        </nav>

        <h1 class="post-title">{title}</h1>
        {description && <p class="post-desc" set:html={renderInlineMd(description)} />}

        <div class="post-meta">
          <span class="post-author">
            <img src={SITE.avatar} alt="" width="28" height="28" loading="lazy" />
            {SITE.name}
          </span>
          <span class="post-meta-item">
            <Icon name="calendar" size={14} />
            <time datetime={isoDate(published)}>{formatDate(published)}</time>
          </span>
          <span class="post-meta-item">
            <Icon name="clock" size={14} />
            {minutes} min de leitura
          </span>
        </div>
      </div>
    </header>

    <div class="post-grid">
      <div class="post-main">
        {
          hasToc && (
            <details class="toc-mobile card">
              <summary>Neste artigo</summary>
              <Toc headings={headings} />
            </details>
          )
        }

        <div class="post-body card rise" style="--i:1">
          <div class="prose">
            <Content />
          </div>

          <footer class="post-foot">
            {
              tags.length > 0 && (
                <div class="post-tags">
                  <Icon name="hash" size={15} />
                  {tags.map((tag) => (
                    <a class="pill" href={tagUrl(tag)}>
                      {tag}
                    </a>
                  ))}
                </div>
              )
            }
            <p class="post-ai">
              Artigo escrito com apoio de IA e revisado pelo autor. Pode conter imprecisões: confirme nas fontes
              citadas e na documentação oficial antes de aplicar. <a href="/about/#site">Saiba mais</a>.
            </p>
          </footer>
        </div>

        {
          (older || newer) && (
            <nav class="post-nav" aria-label="Continue lendo">
              {older ? (
                <a class="post-nav-card" href={`/posts/${older.id}/`} rel="prev">
                  <span class="post-nav-dir">
                    <Icon name="arrowLeft" size={14} /> Artigo anterior
                  </span>
                  <span class="post-nav-title">{older.data.title}</span>
                </a>
              ) : (
                <span />
              )}
              {newer ? (
                <a class="post-nav-card next" href={`/posts/${newer.id}/`} rel="next">
                  <span class="post-nav-dir">
                    Próximo artigo <Icon name="arrowRight" size={14} />
                  </span>
                  <span class="post-nav-title">{newer.data.title}</span>
                </a>
              ) : (
                <span />
              )}
            </nav>
          )
        }
      </div>

      {
        hasToc && (
          <aside class="post-aside">
            <div class="toc-card card">
              <Toc headings={headings} />
            </div>
          </aside>
        )
      }
    </div>
  </article>

  <div class="lightbox" data-lightbox role="dialog" aria-modal="true" aria-label="Imagem ampliada">
    <button type="button" class="lightbox-close" data-lightbox-close aria-label="Fechar">
      <Icon name="close" size={22} />
    </button>
    <img alt="" />
  </div>
</BaseLayout>

<script>
  // lightbox: imagens do corpo do post e a capa abrem em tela cheia
  const box = document.querySelector<HTMLElement>("[data-lightbox]")!;
  const img = box.querySelector("img")!;
  const close = () => box.classList.remove("open");
  const open = (src: string, alt: string, isCover = false) => {
    img.src = src;
    img.alt = alt;
    img.classList.toggle("is-cover", isCover);
    box.classList.add("open");
  };
  box.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).tagName !== "IMG") close();
  });
  document.addEventListener("keydown", (e) => e.key === "Escape" && close());
  document.querySelectorAll<HTMLImageElement>(".prose img").forEach((el) => {
    if (el.closest("a")) return;
    el.addEventListener("click", () => open(el.currentSrc || el.src, el.alt));
  });
  document.querySelector<HTMLElement>("[data-lightbox-cover]")?.addEventListener("click", (e) => {
    const cover = (e.currentTarget as HTMLElement).querySelector("img")!;
    open(cover.src, "", true);
  });
</script>

<style>
  .post {
    --post-max: 1180px;
    max-width: var(--post-max);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--col-gap);
  }

  .post-header {
    overflow: hidden;
    border-radius: 22px;
  }

  .post-cover {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    aspect-ratio: 4 / 1;
    background: #01131b;
    cursor: zoom-in;
    overflow: hidden;
  }

  .post-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-head-body {
    padding: clamp(22px, 3vw, 40px) clamp(20px, 3.4vw, 48px) clamp(24px, 3vw, 36px);
  }

  .post-crumbs {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-meta);
    color: var(--text-dim);
  }

  .post-crumbs a:hover {
    color: var(--blue);
  }

  .post-cat {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    color: var(--c) !important;
  }

  .post-title {
    margin-top: 12px;
    text-wrap: pretty;
    font-family: var(--font-serif);
    font-size: clamp(32px, 4.4vw, 54px);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.028em;
  }

  .post-desc {
    margin: 16px 0 0;
    font-size: clamp(17px, 1.5vw, 19px);
    line-height: 1.6;
    color: var(--text-soft);
  }

  .post-desc :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 1px 5px;
    border-radius: 5px;
    background: var(--card-bg-alt);
    color: var(--text);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 20px;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--divider);
    font-size: var(--fs-body-sm);
    color: var(--text-dim);
  }

  .post-author {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--text);
  }

  .post-author img {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
  }

  .post-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--col-gap);
    align-items: start;
  }

  .post.has-toc .post-grid {
    grid-template-columns: minmax(0, 1fr) 250px;
  }

  .post-main {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--col-gap);
  }

  .post-body {
    padding: clamp(22px, 4vw, 56px) clamp(18px, 4.4vw, 64px);
  }

  .post-body .prose {
    max-width: 760px;
    margin: 0 auto;
  }

  .post-foot {
    max-width: 760px;
    margin: 40px auto 0;
    padding-top: 22px;
    border-top: 1px solid var(--divider);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    color: var(--text-dim);
  }

  .post-ai {
    margin: 14px 0 0;
    padding: 10px 14px;
    border-radius: 10px;
    border: 1px solid color-mix(in srgb, var(--amber) 30%, var(--border));
    background: color-mix(in srgb, var(--amber) 6%, transparent);
    font-size: var(--fs-meta);
    line-height: 1.5;
    color: var(--text-soft);
  }

  .post-ai a {
    color: var(--link);
  }


  .post-aside {
    position: sticky;
    top: calc(var(--nav-height) + 20px);
  }

  .toc-card {
    position: relative;
    max-height: calc(100svh - var(--nav-height) - 40px);
    overflow-y: auto;
    padding: 18px 16px 18px 18px;
    border-radius: var(--radius-md);
    scrollbar-width: thin;
  }

  .toc-mobile {
    display: none;
    border-radius: var(--radius-md);
  }

  .toc-mobile summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
    padding: 14px 18px;
    font-size: var(--fs-body);
    font-weight: 600;
    cursor: pointer;
  }

  .toc-mobile summary::-webkit-details-marker {
    display: none;
  }

  .toc-mobile summary::after {
    content: "";
    width: 7px;
    height: 7px;
    margin-right: 4px;
    border-right: 2px solid var(--text-dim);
    border-bottom: 2px solid var(--text-dim);
    transform: rotate(45deg);
    transition: transform 0.2s ease;
  }

  .toc-mobile[open] summary::after {
    transform: rotate(-135deg);
  }

  .toc-mobile[open] summary {
    border-bottom: 1px solid var(--divider);
  }

  .toc-mobile :global(.toc) {
    padding: 14px 18px 18px;
  }

  .toc-mobile :global(.toc-title) {
    display: none;
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--col-gap);
  }

  .post-nav-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 20px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--card-bg);
    transition:
      border-color 0.2s ease,
      transform 0.2s var(--ease-out);
  }

  .post-nav-card:hover {
    border-color: color-mix(in srgb, var(--blue) 40%, var(--border));
    transform: translateY(-2px);
  }

  .post-nav-card.next {
    text-align: right;
    align-items: flex-end;
  }

  .post-nav-dir {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-meta);
    color: var(--text-dim);
  }

  .post-nav-title {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.25;
  }

  .post-nav-card:hover .post-nav-title {
    color: var(--blue);
  }

  @media (max-width: 1100px) {
    .post.has-toc .post-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .post-aside {
      display: none;
    }
    .toc-mobile {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .post-cover {
      aspect-ratio: 2 / 1;
    }
    .post-nav {
      grid-template-columns: 1fr;
    }
    .post-nav-card.next {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>
