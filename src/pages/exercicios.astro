---
import Main from "../layouts/MainLayout.astro";
import PageHeader from "../components/misc/PageHeader.astro";
import { GetSortedPosts, EXERCISES_CATEGORY } from "../utils/content";
import { IdToSlug } from "../utils/hash";
import { formatDate } from "../utils/date";
import { i18n } from "../locales/translation";
import I18nKeys from "../locales/keys";
import YukinaConfig from "../../yukina.config";

// do mais antigo para o mais novo (Sessão 00 primeiro)
const exercicios = (await GetSortedPosts())
  .filter((post) => post.data.category === EXERCISES_CATEGORY)
  .reverse()
  .map((post, index) => {
    const match = post.data.title.match(/Sessão (\d{2}) — (.*)$/);
    return {
      numero: match?.[1] ?? String(index).padStart(2, "0"),
      titulo: match?.[2] ?? post.data.title,
      enunciado: post.data.enunciado,
      published: post.data.published,
      url: `/posts/${IdToSlug(post.id)}/`,
      readingTime: (post.rendered!.metadata as any).frontmatter.readingMetadata
        ?.time,
    };
  });
---

<Main
  title={i18n(I18nKeys.exercises_title)}
  subTitle={i18n(I18nKeys.exercises_subtitle)}
>
  <div class="space-y-4">
    <!-- como funciona -->
    <section
      class="intro onload-animation"
      style="animation-delay: var(--onload-animation-delay);"
    >
      <PageHeader
        title={i18n(I18nKeys.exercises_title)}
        subTitle={i18n(I18nKeys.exercises_subtitle)}
      />
      <p class="intro-text">
        Um formato de estudo ativo, feito em parceria com IA: ela escolhe um
        assunto e monta um desafio realista, uma resposta inicial é registrada
        sem consultar nada — às vezes errada de propósito — e o exercício
        termina dissecando onde essa resposta fura e o que a solução certa
        exige.
      </p>
      <div class="steps">
        <div class="step">
          <span class="step-num">01</span>
          <div>
            <p class="step-title">Desafio</p>
            <p class="step-desc">
              um problema realista, do jeito que aparece no dia a dia
            </p>
          </div>
        </div>
        <div class="step">
          <span class="step-num">02</span>
          <div>
            <p class="step-title">Resposta inicial</p>
            <p class="step-desc">
              a primeira intuição, registrada antes de estudar
            </p>
          </div>
        </div>
        <div class="step">
          <span class="step-num">03</span>
          <div>
            <p class="step-title">Dissecação</p>
            <p class="step-desc">
              onde a resposta fura e o aprofundamento do tema
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- exercícios -->
    {
      exercicios.map((ex, index) => (
        <a
          class="exercicio onload-animation"
          href={ex.url}
          style={`animation-delay: calc(var(--onload-animation-delay) + ${index + 1} * var(--onload-animation-interval));`}
        >
          <div class="ex-num-col">
            <span class="ex-num">{ex.numero}</span>
          </div>
          <div class="min-w-0 flex-1">
            <p class="ex-eyebrow">Exercício resolvido</p>
            <h2 class="ex-title">{ex.titulo}</h2>
            {ex.enunciado && <p class="ex-enunciado">{ex.enunciado}</p>}
            <p class="ex-meta">
              {formatDate(ex.published, YukinaConfig.locale)}
              {ex.readingTime && (
                <>
                  {" · "}
                  {ex.readingTime} {i18n(I18nKeys.post_card_minutes)}
                </>
              )}
              <span class="ex-cta">Ver a resolução →</span>
            </p>
          </div>
        </a>
      ))
    }
  </div>
</Main>

<style>
  .intro {
    @apply mx-3 rounded-3xl bg-[var(--card-color)] p-6 lg:mx-0 lg:p-8;
  }

  .intro-text {
    @apply text-sm leading-relaxed lg:text-base;
    color: var(--text-color);
    font-family: var(--primary-font);
  }

  .steps {
    @apply mt-5 grid grid-cols-1 gap-3 sm:grid-cols-3;
  }

  .step {
    @apply flex flex-row items-start gap-x-3 rounded-xl p-3;
    border: 1px solid var(--primary-color-transparent);
  }

  .step-num {
    @apply text-xl font-extrabold leading-none;
    color: var(--primary-color);
    font-family: var(--code-font);
  }

  .step-title {
    @apply text-sm font-bold;
    color: var(--text-color);
  }

  .step-desc {
    @apply mt-0.5 text-xs leading-snug;
    color: var(--text-color-lighten);
  }

  .exercicio {
    @apply mx-3 flex flex-row gap-x-5 rounded-3xl bg-[var(--card-color)] p-6 transition-all lg:mx-0 lg:p-8;
    border: 1px solid transparent;
  }

  .exercicio:hover {
    border-color: var(--primary-color);
    transform: translateY(-2px);
  }

  .ex-num-col {
    @apply hidden sm:block;
  }

  .ex-num {
    @apply text-5xl font-extrabold leading-none;
    color: var(--primary-color);
    opacity: 0.35;
    font-family: var(--code-font);
    transition: opacity 0.2s ease;
  }

  .exercicio:hover .ex-num {
    opacity: 1;
  }

  .ex-eyebrow {
    @apply text-[0.65rem] font-bold uppercase;
    letter-spacing: 0.25em;
    color: var(--primary-color);
  }

  .ex-title {
    @apply mt-1 text-xl font-bold leading-snug lg:text-2xl;
    color: var(--text-color);
    font-family: var(--title-font);
  }

  .exercicio:hover .ex-title {
    color: var(--primary-color);
  }

  .ex-enunciado {
    @apply mt-3 rounded-r-lg py-2 pl-4 pr-3 text-sm leading-relaxed;
    color: var(--text-color);
    border-left: 3px solid var(--primary-color);
    background-color: var(--primary-color-transparent);
  }

  .ex-meta {
    @apply mt-3 text-sm;
    color: var(--text-color-lighten);
  }

  .ex-cta {
    @apply ml-3 font-semibold;
    color: var(--primary-color);
  }
</style>
