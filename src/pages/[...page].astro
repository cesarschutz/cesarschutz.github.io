---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import IdentityCard from "../components/IdentityCard.astro";
import QuoteCard from "../components/QuoteCard.astro";
import Sidebar from "../components/Sidebar.astro";
import FeaturedPost from "../components/FeaturedPost.astro";
import PostFeed from "../components/PostFeed.astro";
import AuthorNote from "../components/AuthorNote.astro";
import Pagination from "../components/Pagination.astro";
import { SITE } from "../config";
import { SERIES } from "../data/series";
import { getCategories, getSummaries, type PostSummary } from "../utils/posts";

export const getStaticPaths = (async ({ paginate }) => {
  const all = await getSummaries();
  // destaque: sempre o último post publicado
  const [featured, ...rest] = all;
  return paginate(rest, { pageSize: SITE.pageSize, props: { featured } });
}) satisfies GetStaticPaths;

const { page, featured } = Astro.props as {
  page: { data: PostSummary[]; currentPage: number; lastPage: number; url: { prev?: string; next?: string } };
  featured: PostSummary;
};

const isFirst = page.currentPage === 1;
const summaries = await getSummaries();
const total = summaries.length;
const stats = [
  { value: total, label: "artigos" },
  { value: SERIES.length, label: SERIES.length === 1 ? "série" : "séries" },
  { value: (await getCategories()).length, label: "categorias" },
];
---

<BaseLayout title={isFirst ? undefined : `Artigos — página ${page.currentPage}`}>
  {
    isFirst && (
      <script
        slot="head"
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@graph": [
            { "@type": "WebSite", name: SITE.name, url: SITE.url, inLanguage: "pt-BR", description: SITE.description },
            {
              "@type": "Person",
              name: SITE.name,
              jobTitle: SITE.role,
              url: `${SITE.url}/about/`,
              image: SITE.avatar,
              sameAs: [SITE.github, SITE.linkedin].filter(Boolean),
            },
          ],
        })}
      />
    )
  }
  {isFirst && <IdentityCard stats={stats} />}

  <div class="shell home-shell">
    <Sidebar />

    <div class="shell-main">
      {
        isFirst && (
          <div class="rise" style="--i:1">
            <QuoteCard />
          </div>
        )
      }
      {isFirst && <FeaturedPost post={featured} />}

      <PostFeed
        id="artigos"
        title={isFirst ? "Artigos recentes" : `Artigos — página ${page.currentPage}`}
        subtitle={`${total} artigos publicados`}
        posts={page.data}
        delay={isFirst ? 3 : 0}
      />

      <Pagination current={page.currentPage} last={page.lastPage} prevUrl={page.url.prev} nextUrl={page.url.next} />

      {isFirst && <AuthorNote />}
    </div>
  </div>
</BaseLayout>

<style>
  .home-shell {
    margin-top: var(--col-gap);
  }
</style>
