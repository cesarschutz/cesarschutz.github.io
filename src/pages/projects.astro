---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Icon from "../components/Icon.astro";
import { projects } from "../data/projects";
import { formatDate } from "../utils/format";
---

<BaseLayout title="Projetos" description="Projetos pessoais de Cesar Schutz: agentes de IA, aplicações web e ferramentas.">
  <PageHeader
    eyebrow="Portfólio"
    title="Projetos"
    description="Projetos pessoais onde as ideias dos artigos viram código: agentes de IA, aplicações web e ferramentas."
  />

  <div class="projects">
    {
      projects.map((p, i) => (
        <article class="project card rise" style={`--c:${p.color};--i:${i + 1}`}>
          {p.image && (
            <a
              class="pj-shot"
              href={p.demoUrl ?? p.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              tabindex="-1"
              aria-hidden="true"
            >
              <img src={p.image} alt="" width="1280" height="800" loading="lazy" decoding="async" />
            </a>
          )}
          <div class="pj-head">
            <span class="cat-ico pj-ico">
              <Icon name={p.icon} size={22} />
            </span>
            <h2 class="pj-name">{p.name}</h2>
          </div>
          <p class="pj-desc">{p.description}</p>
          <ul class="pj-tags">
            {p.tags.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
          {p.updated && (
            <p class="pj-updated">Atualizado em {formatDate(new Date(`${p.updated}T12:00:00Z`))}</p>
          )}
          <div class="pj-links">
            {p.demoUrl && (
              <a class="btn btn-primary" href={p.demoUrl} target="_blank" rel="noopener noreferrer">
                Abrir <Icon name="arrowUpRight" size={15} />
              </a>
            )}
            {p.repoUrl && (
              <a class="btn btn-outline" href={p.repoUrl} target="_blank" rel="noopener noreferrer">
                <Icon name="github" size={15} /> Código
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>
</BaseLayout>

<style>
  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: var(--col-gap);
    margin-top: var(--col-gap);
  }

  .project {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 22px;
    overflow: hidden;
    transition: border-color 0.25s ease;
  }

  .project::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(90deg, var(--c), color-mix(in srgb, var(--c) 15%, transparent));
  }

  .project:hover {
    border-color: color-mix(in srgb, var(--c) 40%, var(--border));
  }

  .pj-shot {
    display: block;
    margin: -22px -22px 18px;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: var(--card-bg-alt);
  }

  .pj-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: scale 0.5s var(--ease-out);
  }

  .project:hover .pj-shot img {
    scale: 1.03;
  }

  .pj-updated {
    margin: 14px 0 0;
    font-size: var(--fs-meta);
    color: var(--text-dim);
  }

  .pj-head {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .pj-ico {
    width: 44px;
    height: 44px;
    border-radius: 12px;
  }

  .pj-name {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .pj-desc {
    margin: 14px 0 0;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--text-soft);
  }

  .pj-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  .pj-tags li {
    padding: 3px 9px;
    border-radius: 980px;
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-soft);
  }

  .pj-links {
    display: flex;
    gap: 8px;
    margin-top: auto;
    padding-top: 20px;
  }

  .pj-links .btn {
    font-size: var(--fs-body-sm);
    padding: 8px 14px;
  }
</style>
