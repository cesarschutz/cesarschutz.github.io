---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import Sidebar from "../../components/Sidebar.astro";
import PostFeed from "../../components/PostFeed.astro";
import { getTags, type Group } from "../../utils/posts";

export async function getStaticPaths() {
  const tags = await getTags();
  return tags.map((group) => ({ params: { tag: group.name }, props: { group } }));
}

const { group } = Astro.props as { group: Group };
const count = group.posts.length;
---

<BaseLayout title={`#${group.name}`} description={`Artigos marcados com ${group.name}.`}>
  <div class="shell">
    <Sidebar activeTag={group.name} />
    <div class="shell-main">
      <PageHeader eyebrow="Tag" title={`#${group.name}`} description={`${count} ${count === 1 ? "artigo marcado" : "artigos marcados"} com ${group.name}.`} icon="hash" />
      <PostFeed title="Artigos" posts={group.posts} delay={1} />
    </div>
  </div>
</BaseLayout>
