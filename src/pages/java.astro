---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Icon from "../components/Icon.astro";
import { getPosts, JAVA_SERIES } from "../utils/posts";

// Versões LTS (atualizar quando sair uma nova LTS: Java 29, set/2027)
const LTS = new Set([8, 11, 17, 21, 25]);

// Ano de lançamento real (o `published` dos posts é a data de escrita)
const releaseYear = (v: number): number => {
  if (v === 8) return 2014;
  if (v === 9) return 2017;
  // desde o 10: duas versões por ano, março (par) e setembro (ímpar)
  return 2018 + Math.floor((v - 10) / 2);
};

const posts = await getPosts();
const versions = posts
  .filter((post) => JAVA_SERIES.test(post.id))
  .map((post) => {
    const number = Number(post.id.replace("java-", ""));
    const match = post.data.title.match(/^Java \d+(?: \(LTS\))? — (.*)$/);
    return {
      number,
      subtitle: match?.[1] ?? post.data.title,
      lts: LTS.has(number),
      year: releaseYear(number),
      url: `/posts/${post.id}/`,
    };
  })
  .sort((a, b) => b.number - a.number);

const guide = posts.find((post) => post.id === "guia-atualizacoes-java");
const latest = versions[0];
---

<BaseLayout
  title="Atualizações do Java"
  description="Cada versão do Java explicada: o que mudou, por que importa e exemplos de código, do Java 8 à versão mais recente."
>
  <PageHeader
    eyebrow="Série"
    title="Atualizações do Java"
    description="Cada versão explicada: o que mudou, por que importa e exemplos de código, do Java 8 à versão mais recente. Uma versão nova sai em março e outra em setembro, e cada uma ganha seu artigo aqui."
    icon="coffee"
    color="#f8981d"
  >
    <div class="java-kpis">
      <span><strong>{versions.length}</strong> versões</span>
      <span><strong>{[...LTS].length}</strong> LTS</span>
      {latest && <span>mais recente: <strong>Java {latest.number}</strong></span>}
    </div>
  </PageHeader>

  {
    guide && (
      <a class="guide card rise" style="--i:1" href={`/posts/${guide.id}/`}>
        <span class="cat-ico guide-ico" style="--c:#f8981d">
          <Icon name="book" size={22} />
        </span>
        <span class="guide-text">
          <span class="eyebrow guide-eyebrow">Comece por aqui</span>
          <span class="guide-title">{guide.data.title}</span>
          <span class="guide-desc">
            Como o ciclo de releases funciona, qual distribuição de JDK usar e como migrar com segurança: a base para
            ler as versões.
          </span>
        </span>
        <Icon name="arrowRight" size={20} class="guide-arrow" />
      </a>
    )
  }

  <section class="versions" aria-label="Versões">
    {
      versions.map((v, i) => (
        <a class:list={["version card rise", { lts: v.lts }]} href={v.url} style={`--i:${Math.min(i + 2, 10)}`}>
          <span class="v-top">
            <span class="v-num">{v.number}</span>
            {v.lts && <span class="v-lts">LTS</span>}
          </span>
          <span class="v-title">{v.subtitle}</span>
          <span class="v-year">{v.year}</span>
        </a>
      ))
    }
  </section>
</BaseLayout>

<style>
  .java-kpis {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-top: 16px;
    font-size: var(--fs-body-sm);
    color: var(--text-dim);
  }

  .java-kpis strong {
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .guide {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: var(--col-gap);
    padding: 20px 24px;
    border-color: color-mix(in srgb, #f8981d 30%, var(--border));
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .guide:hover {
    border-color: color-mix(in srgb, #f8981d 60%, var(--border));
    background: color-mix(in srgb, #f8981d 6%, var(--card-bg));
  }

  .guide-ico {
    width: 48px;
    height: 48px;
    border-radius: 14px;
  }

  .guide-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .guide-eyebrow {
    color: #f8981d;
  }

  .guide-title {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 600;
  }

  .guide-desc {
    font-size: var(--fs-body-sm);
    color: var(--text-soft);
  }

  .guide :global(.guide-arrow) {
    flex-shrink: 0;
    color: #f8981d;
    transition: transform 0.2s var(--ease-out);
  }

  .guide:hover :global(.guide-arrow) {
    transform: translateX(3px);
  }

  .versions {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr));
    gap: 12px;
    margin-top: var(--col-gap);
  }

  .version {
    display: flex;
    flex-direction: column;
    padding: 18px 18px 16px;
    border-radius: var(--radius-md);
    transition:
      transform 0.2s var(--ease-out),
      border-color 0.2s ease;
  }

  .version:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, #f8981d 50%, var(--border));
  }

  .version.lts {
    background: linear-gradient(160deg, color-mix(in srgb, #f8981d 9%, var(--card-bg)), var(--card-bg) 60%);
  }

  .v-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .v-num {
    font-family: var(--font-mono);
    font-size: 40px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    color: #f8981d;
  }

  .v-lts {
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #1c1c1e;
    background: #f8981d;
  }

  .v-title {
    margin-top: 12px;
    font-size: var(--fs-body);
    font-weight: 600;
    line-height: 1.35;
  }

  .version:hover .v-title {
    color: var(--blue);
  }

  .v-year {
    margin-top: auto;
    padding-top: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-dim);
  }

  @media (max-width: 560px) {
    .guide {
      align-items: flex-start;
    }
    .guide :global(.guide-arrow) {
      display: none;
    }
  }
</style>
