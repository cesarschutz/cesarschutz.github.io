---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Icon from "../components/Icon.astro";
import { getPosts } from "../utils/posts";
import { JAVA_LTS, RELEASED_LTS } from "../data/java";

const posts = await getPosts();
const versions = JAVA_LTS.map((lts) => {
  const post = posts.find((p) => p.id === `java-${lts.version}`);
  const match = post?.data.title.match(/^Java \d+(?: \(LTS\))? — (.*)$/);
  return {
    ...lts,
    subtitle: match?.[1] ?? post?.data.title ?? "",
    url: post ? `/posts/${post.id}/` : undefined,
  };
}).filter((v) => v.url);

const guide = posts.find((post) => post.id === "guia-atualizacoes-java");
const next = JAVA_LTS.find((v) => v.upcoming);
---

<BaseLayout
  navActive="/series/"
  title="Atualizações do Java"
  description="Cada versão LTS do Java explicada: o que mudou desde a LTS anterior, em qual versão cada recurso chegou, com exemplos de código e fontes oficiais."
>
  <PageHeader
    eyebrow="Séries"
    title="Atualizações do Java"
    description="Uma leitura por versão LTS. Cada artigo reúne o que as versões intermediárias trouxeram desde a LTS anterior, mostra em qual versão cada recurso chegou e traz exemplos de código, diagramas e fontes oficiais."
    icon="coffee"
    color="#f8981d"
  >
    <div class="java-kpis">
      <span><strong>{RELEASED_LTS.length}</strong> LTS lançadas</span>
      <span>mais recente: <strong>Java {RELEASED_LTS[0].version}</strong></span>
      {next && <span>próxima: <strong>Java {next.version}</strong>, prevista para {next.release}</span>}
    </div>
  </PageHeader>

  {
    guide && (
      <a class="guide card rise" style="--i:1" href={`/posts/${guide.id}/`}>
        <span class="cat-ico guide-ico" style="--c:#f8981d">
          <Icon name="book" size={22} />
        </span>
        <span class="guide-text">
          <span class="eyebrow guide-eyebrow">Comece por aqui</span>
          <span class="guide-title">{guide.data.title}</span>
          <span class="guide-desc">
            Como o ciclo de releases funciona, qual distribuição de JDK usar e como migrar com segurança: a base para
            ler as LTS.
          </span>
        </span>
        <Icon name="arrowRight" size={20} class="guide-arrow" />
      </a>
    )
  }

  <section class="versions" aria-label="Versões LTS">
    {
      versions.map((v, i) => (
        <a class:list={["version card rise", { upcoming: v.upcoming }]} href={v.url} style={`--i:${i + 2}`}>
          <span class="v-top">
            <span class="v-num">{v.version}</span>
            <span class="v-badge">{v.upcoming ? "Próxima LTS" : "LTS"}</span>
          </span>
          <span class="v-title">{v.subtitle}</span>
          <span class="v-meta">
            <span class="v-covers">{v.covers}</span>
            <span class="v-year">{v.upcoming ? `previsto: ${v.release}` : v.release}</span>
          </span>
        </a>
      ))
    }
  </section>
</BaseLayout>

<style>
  .java-kpis {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-top: 16px;
    font-size: var(--fs-body-sm);
    color: var(--text-dim);
  }

  .java-kpis strong {
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .guide {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: var(--col-gap);
    padding: 20px 24px;
    border-color: color-mix(in srgb, #f8981d 30%, var(--border));
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .guide:hover {
    border-color: color-mix(in srgb, #f8981d 60%, var(--border));
    background: color-mix(in srgb, #f8981d 6%, var(--card-bg));
  }

  .guide-ico {
    width: 48px;
    height: 48px;
    border-radius: 14px;
  }

  .guide-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .guide-eyebrow {
    color: color-mix(in srgb, #f8981d var(--ink-mix), #000);
  }

  .guide-title {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 600;
  }

  .guide-desc {
    font-size: var(--fs-body-sm);
    color: var(--text-soft);
  }

  .guide :global(.guide-arrow) {
    flex-shrink: 0;
    color: #f8981d;
    transition: transform 0.2s var(--ease-out);
  }

  .guide:hover :global(.guide-arrow) {
    transform: translateX(3px);
  }

  .versions {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--col-gap);
    margin-top: var(--col-gap);
  }

  .version {
    display: flex;
    flex-direction: column;
    padding: 22px 22px 20px;
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, color-mix(in srgb, #f8981d 9%, var(--card-bg)), var(--card-bg) 60%);
    transition:
      transform 0.2s var(--ease-out),
      border-color 0.2s ease;
  }

  .version:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, #f8981d 50%, var(--border));
  }

  .version.upcoming {
    background: var(--card-bg);
    border-style: dashed;
    border-color: color-mix(in srgb, #f8981d 45%, var(--border));
  }

  .v-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .v-num {
    font-family: var(--font-mono);
    font-size: 52px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    color: #f8981d;
  }

  .v-badge {
    padding: 3px 10px;
    border-radius: 980px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #1c1c1e;
    background: #f8981d;
  }

  .upcoming .v-badge {
    color: color-mix(in srgb, #f8981d var(--ink-mix), #000);
    background: color-mix(in srgb, #f8981d 14%, transparent);
  }

  .v-title {
    margin-top: 14px;
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }

  .version:hover .v-title {
    color: var(--blue);
  }

  .v-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 12px;
    margin-top: auto;
    padding-top: 16px;
    font-size: var(--fs-meta);
    color: var(--text-dim);
  }

  .v-year {
    font-family: var(--font-mono);
    font-size: 12px;
  }

  @media (max-width: 560px) {
    .guide {
      align-items: flex-start;
    }
    .guide :global(.guide-arrow) {
      display: none;
    }
  }
</style>
