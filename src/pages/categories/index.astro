---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import Icon from "../../components/Icon.astro";
import { getCategories } from "../../utils/posts";
import { categoryStyle, categoryUrl } from "../../utils/taxonomy";

const categories = await getCategories();
---

<BaseLayout navActive="/archive/" title="Categorias" description="Os artigos organizados por área.">
  <PageHeader eyebrow="Explorar" title="Categorias" description="Os artigos organizados por área." />

  <div class="cat-grid">
    {
      categories.map((cat, i) => {
        const style = categoryStyle(cat.name);
        return (
          <a class="cat-card card rise" href={categoryUrl(cat.name)} style={`--c:${style.color};--i:${i + 1}`}>
            <div class="cc-head">
              <span class="cat-ico cc-ico">
                <Icon name={style.icon} size={22} />
              </span>
              <span class="cc-count">
                {cat.posts.length} {cat.posts.length === 1 ? "artigo" : "artigos"}
              </span>
            </div>
            <h2 class="cc-name">{cat.name}</h2>
            {style.description && <p class="cc-desc">{style.description}</p>}
            <ul class="cc-latest">
              {cat.posts.slice(0, 3).map((p) => (
                <li>{p.title}</li>
              ))}
            </ul>
          </a>
        );
      })
    }
  </div>
</BaseLayout>

<style>
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--col-gap);
    margin-top: var(--col-gap);
  }

  .cat-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 22px;
    overflow: hidden;
    transition:
      transform 0.25s var(--ease-out),
      border-color 0.25s ease;
  }

  .cat-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(90deg, var(--c), color-mix(in srgb, var(--c) 20%, transparent));
  }

  .cat-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--c) 45%, var(--border));
  }

  .cc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cc-ico {
    width: 44px;
    height: 44px;
    border-radius: 12px;
  }

  .cc-count {
    font-size: var(--fs-meta);
    color: var(--text-dim);
  }

  .cc-name {
    margin-top: 16px;
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .cc-desc {
    margin: 6px 0 0;
    font-size: var(--fs-body-sm);
    color: var(--text-soft);
  }

  .cc-latest {
    margin: 16px 0 0;
    padding: 14px 0 0;
    border-top: 1px solid var(--divider);
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: var(--fs-meta);
    color: var(--text-dim);
  }

  .cc-latest li {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
